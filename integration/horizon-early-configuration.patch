+// Owner-direct split tests require the real compatibility reassembler, supplied
+// only when the companion is wired (not in the isolated dependency-free run).
+#[allow(unexpected_cfgs)]
+#[cfg(not(compat_isolated))]
+mod companion {
+    use super::*;
+    use horizon_neoforge_compat::{
+        modded::{ConnectionProtocol, Flow},
+        split::{OutboundPacket, OutboundSplitter, Reassembler},
+    };
+
+    /// Adapt the compatibility reassembler to the engine's local trait.
+    struct CompatReassembly(Reassembler);
+    impl ordered_owner::Reassembly for CompatReassembly {
+        fn receive(
+            &mut self,
+            body: &[u8],
+            now_ms: u64,
+        ) -> std::result::Result<Option<Vec<u8>>, String> {
+            self.0.receive(body, now_ms).map_err(|e| e.to_string())
+        }
+        fn check_deadline(&mut self, now_ms: u64) -> std::result::Result<(), String> {
+            self.0.check_deadline(now_ms).map_err(|e| e.to_string())
+        }
+        fn close(&mut self) {
+            self.0.close();
+        }
+    }
+
+    fn configured_pair() -> (Connection, Connection) {
+        let (client, server) = horizon_protocol::connection::Pipe::pair();
+        let mut client = Connection::local(client);
+        let mut server = Connection::local(server);
+        client.adapt(horizon_protocol::adapter::ServerVersion::V1_21_1);
+        client
+            .send(
+                &handshake::Serverbound::Intention(handshake::Intention {
+                    protocol: PROTOCOL_VERSION,
+                    host: "localhost".into(),
+                    port: 25565,
+                    intent: handshake::LOGIN,
+                })
+                .encode(),
+            )
+            .unwrap();
+        server.recv().unwrap();
+        server.send(&[2]).unwrap();
+        client.recv().unwrap();
+        client
+            .send(&login::Serverbound::LoginAcknowledged(Empty).encode())
+            .unwrap();
+        server.recv().unwrap();
+        (client, server)
+    }
+
+    fn fragment(marker: u8, content: &[u8]) -> Vec<u8> {
+        let mut w = horizon_protocol::buf::Writer::new();
+        w.varint((content.len() + 1) as i32);
+        w.bytes(&[marker]);
+        w.bytes(content);
+        w.data
+    }
+
+    fn owner_with_authority<'a>(
+        epoch: ordered_owner::Epoch,
+        profile: &'a Profile,
+    ) -> ordered_owner::OrderedOwner<'a> {
+        ordered_owner::OrderedOwner::new(
+            epoch,
+            profile,
+            Some(Box::new(CompatReassembly(Reassembler::new()))),
+        )
+        .unwrap()
+    }
+
+    /// With genuine (test-granted) split authority, the owner reassembles a
+    /// fragmented original, the caller decodes it exactly once, and the inner
+    /// payload is dispatched.
+    #[test]
+    fn owner_reassembles_split_then_dispatches_exactly_once() {
+        let (mut client, mut server) = configured_pair();
+        let observed = Arc::new(Observed::default());
+        let profile = profile(&observed);
+        let epoch = ordered_owner::Epoch(7);
+        let mut owner = owner_with_authority(epoch, &profile);
+        let packet = cfg::Clientbound::CustomPayload(cfg::CustomPayload {
+            channel: "c:version".into(),
+            data: vec![1, 1],
+        })
+        .encode();
+        // Queue a real socket packet that must NOT be consumed while reassembling.
+        server.send(&[14, 0]).unwrap();
+        let mut assembled = None;
+        for (index, part) in [fragment(1, &packet[..1]), fragment(2, &packet[1..])]
+            .into_iter()
+            .enumerate()
+        {
+            match owner.receive(ordered_owner::SPLIT_CHANNEL, &part).unwrap() {
+                ordered_owner::Step::Partial => assert_eq!(index, 0),
+                ordered_owner::Step::Assembled(original) => {
+                    assert_eq!(index, 1);
+                    assembled = Some(original);
+                }
+                ordered_owner::Step::Replies(_) => panic!("split fragment is not a reply"),
+            }
+        }
+        let (id, body) = client
+            .reader
+            .decode_reassembled_configuration(assembled.unwrap())
+            .unwrap();
+        let cfg::Clientbound::CustomPayload(inner) = cfg::Clientbound::decode(id, &body).unwrap()
+        else {
+            panic!("expected reconstructed custom payload");
+        };
+        let replies = owner.dispatch(&inner.channel, &inner.data).unwrap();
+        assert_eq!(replies.len(), 1);
+        assert_eq!(replies[0].body, [1, 1]);
+        // The queued socket packet is still independent and unread.
+        assert_eq!(client.recv().unwrap(), (15, vec![0]));
+        // Epoch is live and finish still refuses.
+        assert!(owner.active(epoch));
+        assert!(!owner.active(ordered_owner::Epoch(8)));
+        assert!(owner.finish().is_err());
+    }
+
+    /// The owner's idle poll is wired and terminal: once the epoch is terminated
+    /// the poll and any further work refuse. The absolute 30s deadline arithmetic
+    /// itself is covered by the core `split` reassembler tests.
+    #[test]
+    fn owner_idle_poll_is_terminal_after_teardown() {
+        let (_client, _server) = configured_pair();
+        let observed = Arc::new(Observed::default());
+        let profile = profile(&observed);
+        let mut owner = owner_with_authority(ordered_owner::Epoch(1), &profile);
+        assert!(matches!(
+            owner
+                .receive(ordered_owner::SPLIT_CHANNEL, &fragment(1, &[14]))
+                .unwrap(),
+            ordered_owner::Step::Partial
+        ));
+        owner.poll_idle().unwrap(); // before teardown, a pending assembly polls clean
+        owner.terminate();
+        assert!(owner.is_terminated());
+        assert!(owner.receive("c:version", &[1, 1]).is_err());
+        assert!(owner.poll_idle().is_err());
+        owner.terminate(); // idempotent
+        assert_eq!(observed.resets.load(Ordering::Relaxed), 1);
+    }
+
+    /// Without authority the owner never reassembles a split payload: it is an
+    /// ordinary (unsupported) bridge task. The outbound splitter is a separate,
+    /// opt-in primitive and is not wired by default.
+    #[test]
+    fn owner_without_authority_never_reassembles_split() {
+        let (_client, _server) = configured_pair();
+        let observed = Arc::new(Observed::default());
+        let profile = profile(&observed);
+        let mut owner =
+            ordered_owner::OrderedOwner::new(ordered_owner::Epoch(1), &profile, None).unwrap();
+        assert!(
+            owner
+                .receive(ordered_owner::SPLIT_CHANNEL, &fragment(1, &[14]))
+                .is_err()
+        );
+        let splitter =
+            OutboundSplitter::new(Flow::Serverbound, ConnectionProtocol::Configuration, 128)
+                .unwrap();
+        assert!(matches!(
+            splitter.encode(&[7, 0]).unwrap(),
+            OutboundPacket::Unsplit(_)
+        ));
+    }
+}
+
+/// No compiler-only façade: these exercise the actual bounded worker/transport.
+fn unadapted_local_writer() -> (QueuedWriter, Connection) {
+    let (client, peer) = horizon_protocol::connection::Pipe::pair();
+    let (_, writer) = Connection::local(client).split();
+    (QueuedWriter::new(writer).unwrap(), Connection::local(peer))
+}
+
+#[test]
+fn owner_batch_completion_waits_for_real_pipe_write_and_preserves_order() {
+    let (writer, mut peer) = unadapted_local_writer();
+    let receipt = writer
+        .send_batch(vec![vec![0; 70_000], vec![1, 42]])
+        .unwrap();
+    // A pending completion must prevent transferring the physical socket to a
+    // successor whose lifetime the old receipt could otherwise cancel.
+    assert!(writer.drain_and_take().is_err());
+    let worker = std::thread::spawn(move || receipt.wait(Duration::from_secs(2)));
+    assert_eq!(peer.recv().unwrap(), (0, vec![0; 69_999]));
+    assert_eq!(peer.recv().unwrap(), (1, vec![42]));
+    worker.join().unwrap().unwrap();
+    writer.drain_and_take().unwrap().shutdown();
+}
+
+#[test]
+fn owner_batch_timeout_closes_blocked_transport_and_cancels_later_jobs() {
+    let (writer, mut peer) = unadapted_local_writer();
+    // >64KiB cannot finish while the peer is idle. No sleep/racy scheduler
+    // assumption: even a fully scheduled worker must block inside write_all.
+    let receipt = writer
+        .send_batch(vec![vec![0; 70_000], vec![1, 99]])
+        .unwrap();
+    writer.send(&[2, 88]).unwrap();
+    let error = receipt.wait(Duration::from_millis(10)).unwrap_err();
+    assert!(error.to_string().contains("deadline"));
+    assert!(writer.send(&[3]).is_err());
+    assert!(writer.drain_and_take().is_err()); // joins: blocked write was closed
+    peer.reader
+        .set_read_timeout(Some(Duration::from_millis(20)))
+        .unwrap();
+    assert!(
+        peer.recv().is_err(),
+        "partial original must not become a success"
+    );
+}
+
+#[test]
+fn owner_batch_dropped_receipt_cancels_without_waiting_or_replay() {
+    let (writer, mut peer) = unadapted_local_writer();
+    let receipt = writer
+        .send_batch(vec![vec![0; 70_000], vec![1, 99]])
+        .unwrap();
+    drop(receipt);
+    assert!(writer.send(&[2, 88]).is_err());
+    assert!(writer.drain_and_take().is_err());
+    assert!(peer.recv().is_err());
+    // Independent successor stays usable; old cancellation has no global effect.
+    let (next, mut peer) = unadapted_local_writer();
+    next.send_batch(vec![vec![7, 8]])
+        .unwrap()
+        .wait(Duration::from_secs(1))
+        .unwrap();
+    assert_eq!(peer.recv().unwrap(), (7, vec![8]));
+    next.drain_and_take().unwrap().shutdown();
+}
+
+#[test]
+fn owner_batch_admission_counts_packet_count_outer_and_inner_capacity() {
+    let (writer, mut peer) = unadapted_local_writer();
+    assert!(writer.send_batch(vec![vec![]; 1_025]).is_err());
+    // Length alone is insufficient: a small body may retain huge capacity.
+    let mut oversized = Vec::with_capacity(16 * 1024 * 1024);
+    oversized.push(0);
+    assert!(writer.send_batch(vec![oversized]).is_err());
+    let mut outer = Vec::with_capacity(16 * 1024 * 1024 / std::mem::size_of::<Vec<u8>>() + 1);
+    outer.push(vec![0]);
+    assert!(writer.send_batch(outer).is_err());
+    assert!(writer.send_batch(vec![]).is_err());
+    // Refusals exposed zero packets and did not poison an otherwise live writer.
+    writer
+        .send_batch(vec![vec![4, 5]])
+        .unwrap()
+        .wait(Duration::from_secs(1))
+        .unwrap();
+    assert_eq!(peer.recv().unwrap(), (4, vec![5]));
+    writer.drain_and_take().unwrap().shutdown();
+}
