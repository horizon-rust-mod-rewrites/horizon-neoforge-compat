+/// transport, even if the shared writer is absent or cloning a closer would fail.
+/// Default configuration uses the same borrow with terminal cleanup disabled.
+struct EarlyTransportGuard<'a> {
+    reader: &'a mut ConnReader,
+    writer: Option<QueuedWriter>,
+    enabled: bool,
+}
+impl Drop for EarlyTransportGuard<'_> {
+    fn drop(&mut self) {
+        if self.enabled {
+            self.reader.shutdown();
+            if let Some(writer) = &self.writer {
+                writer.shutdown();
+            }
+        }
+    }
+}
