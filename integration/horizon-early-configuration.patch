+        let (mut client, mut peer) = configured();
+        peer.send(&[14, 0]).unwrap();
+        client.reader.fill(0).unwrap();
+        let pending = client.reader.buffer[client.reader.start..client.reader.end].to_vec();
+        let bytes_in = client.reader.counters.bytes_in.load(Ordering::Relaxed);
+        let received = client.reader.counters.received.load(Ordering::Relaxed);
+        let sent = client.reader.counters.sent.load(Ordering::Relaxed);
+        assert_eq!(
+            client
+                .reader
+                .decode_reassembled_configuration(vec![14, 0])
+                .unwrap(),
+            (15, vec![0])
+        );
+        assert_eq!(
+            &client.reader.buffer[client.reader.start..client.reader.end],
+            pending
+        );
+        assert_eq!(
+            client.reader.counters.bytes_in.load(Ordering::Relaxed),
+            bytes_in
+        );
+        assert_eq!(
+            client.reader.counters.received.load(Ordering::Relaxed),
+            received
+        );
+        assert_eq!(client.reader.counters.sent.load(Ordering::Relaxed), sent);
+        assert_eq!(client.recv().unwrap(), (15, vec![0]));
+        assert_eq!(
+            client.reader.counters.received.load(Ordering::Relaxed),
+            received + 1
+        );
+        // No bytes read or response fabricated by decoding the reconstructed original.
+        assert_eq!(
+            client.reader.counters.bytes_in.load(Ordering::Relaxed),
+            bytes_in
