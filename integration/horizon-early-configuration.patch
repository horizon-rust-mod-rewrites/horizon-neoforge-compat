+/// Bound early writes independently of socket read timeouts. Never wait while
+/// holding shared_writer or an engine lock: cancellation must be able to close it.
+const EARLY_WRITE_TIMEOUT: Duration = Duration::from_secs(5);
+
+fn emit_early_bodies(
+    writer: &Arc<Mutex<Option<QueuedWriter>>>,
+    lang: &Language,
+    bodies: Vec<Vec<u8>>,
+) -> Result<(), Reason> {
+    let writer = writer
+        .lock()
+        .unwrap()
+        .as_ref()
+        .cloned()
+        .ok_or_else(|| Reason::plain("Disconnected"))?;
+    writer
+        .send_batch(bodies)
+        .and_then(|receipt| receipt.wait(EARLY_WRITE_TIMEOUT))
+        .map_err(|error| Reason::plain(connection_lost(error, lang)))
+}
