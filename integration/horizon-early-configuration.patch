@@ -0,0 +1,218 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//! Single ordered connection owner for the explicit NeoForge configuration path.
+//!
+//! This is the serialization domain the early endpoint previously lacked: one
+//! owner per configuration epoch that tags every operation with that epoch,
+//! serializes split reassembly with the connection's socket ingress, drives an
+//! idle deadline for partial assembly even when no packet arrives, and terminally
+//! tears the epoch down (dropping partial assembly and resetting the bridge) on
+//! any failure, disconnect, transfer or reconfiguration.
+//!
+//! The owner does not own the socket reader: the configure loop reads the socket
+//! and, on a completed reassembly, decodes the reconstructed original exactly
+//! once with the real protocol-767 decoder before handing the inner payload back
+//! to [`OrderedOwner::dispatch`]. This keeps a single reader and a single
+//! serialization domain rather than a second façade over the same connection.
+//!
+//! The engine stays dependency-free: split reassembly is provided through the
+//! local [`Reassembly`] trait. Production installs none (split authority is never
+//! granted without a genuine negotiated grant and host inventory), so the owner
+//! never reassembles by default. The compatibility companion supplies a real
+//! bounded reassembler for tests and future authority.
+//!
+//! The engine's hard finish latch is unchanged: [`OrderedOwner::finish`] still
+//! refuses, so this owner can never fabricate a configuration acknowledgement or
+//! expose modded content to vanilla translation. Default connections never build
+//! an owner; only an explicitly selected `early_configuration::Profile` does.
+use std::time::Instant;
+
+use horizon_protocol::Error;
+
+use super::early_configuration::{Endpoint, Profile, Reply};
+
+/// The registered split transport channel. A local constant so the engine patch
+/// stays dependency-free; the compatibility crate uses the same literal.
+pub(crate) const SPLIT_CHANNEL: &str = "neoforge:split";
+
+/// A bounded inbound split reassembler, supplied by the compatibility layer. One
+/// instance per epoch/direction. `now_ms` is a host monotonic elapsed-millisecond
+/// clock, never wall time. An error is terminal for the epoch.
+pub trait Reassembly: Send {
+    /// Feed one split fragment body. Returns the whole original once the final
+    /// fragment arrives, else `None` for a partial fragment.
+    fn receive(&mut self, body: &[u8], now_ms: u64)
+    -> std::result::Result<Option<Vec<u8>>, String>;
+    /// Drive the absolute idle deadline even when no packet arrives.
+    fn check_deadline(&mut self, now_ms: u64) -> std::result::Result<(), String>;
+    /// Drop partial state. Called on terminal teardown.
+    fn close(&mut self);
+}
+
+/// The owner's monotonic epoch tag. A fresh value is minted for each
+/// configuration; stale callbacks, timers and prepared work carry an older tag
+/// and are refused by [`OrderedOwner::active`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Epoch(pub u64);
+
+/// What one inbound payload produced under the owner.
+pub(crate) enum Step {
+    /// A bridge reply batch the caller must emit atomically and in order.
+    Replies(Vec<Reply>),
+    /// A completed split assembly: the caller decodes this original exactly once
+    /// with the real decoder, then calls [`OrderedOwner::dispatch`] on the inner
+    /// custom payload.
+    Assembled(Vec<u8>),
+    /// A partial split fragment was accepted; no original is ready yet.
+    Partial,
+}
+
+/// One owner for one configuration epoch. It owns the early bridge endpoint and,
+/// when authority is installed, the inbound reassembler; both are released when
+/// the owner drops, resetting the bridge on every exit path.
+pub(crate) struct OrderedOwner<'a> {
+    epoch: Epoch,
+    endpoint: Option<Endpoint<'a>>,
+    reassembly: Option<Box<dyn Reassembly>>,
+    /// Owner creation instant, the base for the monotonic millisecond clock the
+    /// reassembler's absolute idle deadline is measured against.
+    base: Instant,
+    terminated: bool,
+}
+
+impl<'a> OrderedOwner<'a> {
+    /// Begin a new epoch. `reassembly` is `Some` only from a genuine negotiated
+    /// split grant; production passes `None`.
+    pub(crate) fn new(
+        epoch: Epoch,
+        profile: &'a Profile,
+        reassembly: Option<Box<dyn Reassembly>>,
+    ) -> horizon_protocol::Result<Self> {
+        Ok(Self {
+            epoch,
+            endpoint: Some(
+                profile.begin().map_err(|failure| {
+                    Error::new(format!("configuration/bootstrap: {failure:?}"))
+                })?,
+            ),
+            reassembly,
+            base: Instant::now(),
+            terminated: false,
+        })
+    }
+
+    pub(crate) fn epoch(&self) -> Epoch {
+        self.epoch
+    }
+
+    pub(crate) fn is_terminated(&self) -> bool {
+        self.terminated
+    }
+
+    /// Whether `tag` is this owner's live epoch. Stale work is refused.
+    pub(crate) fn active(&self, tag: Epoch) -> bool {
+        !self.terminated && tag == self.epoch
+    }
+
+    fn now_ms(&self) -> u64 {
+        // Monotonic elapsed milliseconds, never wall time. Saturating keeps a
+        // very long-lived owner from wrapping the reassembler's clock.
+        u64::try_from(self.base.elapsed().as_millis()).unwrap_or(u64::MAX)
+    }
+
+    /// Handle one inbound configuration custom payload under this epoch. With
+    /// split authority, a `neoforge:split` fragment is reassembled; every other
+    /// payload (and all payloads without authority) goes straight to the bridge.
+    pub(crate) fn receive(&mut self, channel: &str, body: &[u8]) -> horizon_protocol::Result<Step> {
+        if self.terminated {
+            return Err(Error::new("terminated owner epoch"));
+        }
+        // Ordinary traffic cannot postpone the absolute assembly deadline.
+        self.poll_idle()?;
+        if channel == SPLIT_CHANNEL && self.reassembly.is_some() {
+            let now = self.now_ms();
+            let reassembler = self.reassembly.as_mut().expect("checked");
+            let assembled = reassembler.receive(body, now);
+            let assembled = assembled.map_err(|error| self.fail(Error::new(error)))?;
+            return Ok(match assembled {
+                Some(original) => Step::Assembled(original),
+                None => Step::Partial,
+            });
+        }
+        let result = self
+            .endpoint
+            .as_mut()
+            .expect("live endpoint")
+            .receive(channel, body);
+        result
+            .map(Step::Replies)
+            .map_err(|error| self.fail(Error::new(format!("{:?}", error.0))))
+    }
+
+    /// Dispatch the inner custom payload of a reconstructed original the caller
+    /// decoded exactly once. Used only after [`Step::Assembled`].
+    pub(crate) fn dispatch(
+        &mut self,
+        channel: &str,
+        body: &[u8],
+    ) -> horizon_protocol::Result<Vec<Reply>> {
+        if self.terminated {
+            return Err(Error::new("terminated owner epoch"));
+        }
+        let result = self
+            .endpoint
+            .as_mut()
+            .expect("live endpoint")
+            .receive(channel, body);
+        result.map_err(|error| self.fail(Error::new(format!("{:?}", error.0))))
+    }
+
+    /// Drive the idle deadline for a partial split assembly. The caller invokes
+    /// this from its read-timeout path so a partial assembly expires even when no
+    /// further packet arrives. Ordinary traffic does not extend the absolute
+    /// deadline; the reassembler enforces that from its own start instant.
+    pub(crate) fn poll_idle(&mut self) -> horizon_protocol::Result<()> {
+        if self.terminated {
+            return Err(Error::new("terminated owner epoch"));
+        }
+        let Some(reassembler) = self.reassembly.as_mut() else {
+            return Ok(());
+        };
+        let now = u64::try_from(self.base.elapsed().as_millis()).unwrap_or(u64::MAX);
+        let result = reassembler.check_deadline(now);
+        result.map_err(|error| self.fail(Error::new(error)))
+    }
+
+    /// The finish barrier. Still a hard refusal at this milestone: the owner has
+    /// no bidirectional modded content conversion or play route, so it can never
+    /// acknowledge configuration completion.
+    pub(crate) fn finish(&mut self) -> horizon_protocol::Result<()> {
+        if self.terminated {
+            return Err(Error::new("terminated owner epoch"));
+        }
+        let result = self.endpoint.as_mut().expect("live endpoint").finish();
+        result.map_err(|error| self.fail(Error::new(format!("{:?}", error.0))))
+    }
+
+    /// Terminal teardown: poison the epoch, drop partial assembly and reset the
+    /// bridge. Idempotent; also runs on Drop so every exit path cleans up.
+    pub(crate) fn terminate(&mut self) {
+        self.terminated = true;
+        // Reset the bridge now, not only when a caller eventually drops us.
+        // Taking it also makes repeated terminate/Drop exactly-once.
+        self.endpoint.take();
+        if let Some(mut reassembler) = self.reassembly.take() {
+            reassembler.close();
+        }
+    }
+
+    fn fail(&mut self, error: Error) -> Error {
+        self.terminate();
+        error
+    }
+}
+
+impl Drop for OrderedOwner<'_> {
+    fn drop(&mut self) {
+        self.terminate();
+    }
+}
