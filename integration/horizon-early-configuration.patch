+impl WriteReceipt {
+    pub(crate) fn wait(mut self, timeout: Duration) -> Result<()> {
+        let result = match self.completion.recv_timeout(timeout) {
+            Ok(Ok(())) if self.writer.alive.load(Ordering::Acquire) => Ok(()),
