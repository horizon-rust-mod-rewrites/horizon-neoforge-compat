+#[cfg(test)]
+mod neoforge_configuration_framing_tests {
+    use super::*;
+    use crate::{
+        connection::Connection,
+        packets::{Empty, configuration as cfg, login},
+    };
+
+    #[test]
+    fn protocol_767_configuration_payload_bodies_cross_tcp_in_both_directions() {
+        // Synthetic opaque bytes, NOT a valid loader negotiation transcript.
+        // Real TCP exercises VarInt framing; Pipe uses a different private frame.
+        let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let stream = std::net::TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (peer, _) = listener.accept().unwrap();
+        let mut client = Connection::from_stream(stream).unwrap();
+        let mut server = Connection::from_stream(peer).unwrap();
+        client
+            .reader
+            .set_read_timeout(Some(std::time::Duration::from_secs(2)))
+            .unwrap();
+        server
+            .reader
+            .set_read_timeout(Some(std::time::Duration::from_secs(2)))
+            .unwrap();
+        client.adapt(ServerVersion::V1_21_1);
+        client
+            .send(
+                &handshake::Serverbound::Intention(handshake::Intention {
+                    protocol: crate::PROTOCOL_VERSION,
+                    host: "localhost".into(),
+                    port: 25565,
+                    intent: handshake::LOGIN,
+                })
+                .encode(),
+            )
+            .unwrap();
+        let (id, bytes) = server.recv().unwrap();
+        let intention = handshake::decode_intention(id, &bytes, 255).unwrap();
+        assert_eq!(intention.protocol, 767);
+        // State tracking only: Session does not decode the profile at this point.
+        server.send(&[2]).unwrap();
+        assert_eq!(
+            client.recv().unwrap().0,
+            crate::ids::login::clientbound::LOGIN_FINISHED
+        );
+        client
+            .send(&login::Serverbound::LoginAcknowledged(Empty).encode())
+            .unwrap();
+        assert_eq!(server.recv().unwrap(), (3, vec![]));
+        let mut old_clientbound = vec![1, 17];
+        old_clientbound.extend_from_slice(b"neoforge:register");
+        old_clientbound.extend_from_slice(&[0, 128, 255, 0]);
+        server.send(&old_clientbound).unwrap();
+        let (id, payload) = client.recv().unwrap();
+        assert_eq!(id, 1); // 767 clientbound configuration custom_payload
+        assert_eq!(payload, old_clientbound[1..]);
+        let cfg::Clientbound::CustomPayload(received) =
+            cfg::Clientbound::decode(id, &payload).unwrap()
+        else {
+            panic!("expected custom payload");
+        };
+        assert_eq!(received.channel, "neoforge:register");
+        assert_eq!(received.data, [0, 128, 255, 0]);
+        client
+            .send(
+                &cfg::Serverbound::CustomPayload(received)
+                    .try_encode()
+                    .unwrap(),
+            )
+            .unwrap();
+        let (id, payload) = server.recv().unwrap();
+        assert_eq!(id, 2); // 767 serverbound configuration custom_payload
+        assert_eq!(payload, old_clientbound[1..]);
+        // Non-identity packet-id evidence: 767 known packs is 14, not pinned 15.
+        server.send(&[14, 0]).unwrap();
+        assert_eq!(client.recv().unwrap(), (15, vec![0]));
+        client
+            .send(
+                &cfg::Serverbound::SelectKnownPacks(cfg::SelectKnownPacks { packs: vec![] })
+                    .encode(),
+            )
+            .unwrap();
+        assert_eq!(server.recv().unwrap(), (7, vec![0]));
+    }
+}
