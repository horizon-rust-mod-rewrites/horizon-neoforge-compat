+    fn outbound_configured_version(version: ServerVersion) -> (Connection, Connection) {
+        let listener = std::net::TcpListener::bind(("127.0.0.1", 0)).unwrap();
+        let stream = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+        let (peer, _) = listener.accept().unwrap();
+        let mut client = Connection::from_stream(stream).unwrap();
+        let mut peer = Connection::from_stream(peer).unwrap();
+        for c in [&mut client, &mut peer] {
+            c.reader
+                .set_read_timeout(Some(Duration::from_secs(2)))
+                .unwrap();
+        }
+        client.adapt(version);
+        client
+            .send(
+                &handshake::Serverbound::Intention(handshake::Intention {
+                    protocol: crate::PROTOCOL_VERSION,
+                    host: "localhost".into(),
+                    port: 25565,
+                    intent: handshake::LOGIN,
+                })
+                .encode(),
+            )
+            .unwrap();
+        peer.recv().unwrap();
+        // Actual Session phase tracking; not a successful login/profile claim.
+        peer.send(&[2]).unwrap();
+        client.recv().unwrap();
+        client
+            .send(&login::Serverbound::LoginAcknowledged(Empty).encode())
+            .unwrap();
+        peer.recv().unwrap();
+        (client, peer)
+    }
