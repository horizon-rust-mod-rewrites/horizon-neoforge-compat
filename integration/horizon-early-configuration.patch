+// SPDX-License-Identifier: LGPL-3.0-or-later
+use super::*;
+use std::sync::{
+    Mutex,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Default)]
+struct Observed {
+    created: AtomicUsize,
+    resets: AtomicUsize,
+    finishes: AtomicUsize,
+    received: Mutex<Vec<(String, Vec<u8>)>>,
+}
+struct VersionBridge(Arc<Observed>);
+impl Bridge for VersionBridge {
+    fn receive(&mut self, channel: &str, body: &[u8]) -> Result<Vec<Reply>> {
+        self.0
+            .received
+            .lock()
+            .unwrap()
+            .push((channel.into(), body.to_vec()));
+        // Test-only implementation of a single real body transformation, NOT a
+        // required-task placeholder. Every other loader task is refused.
+        if channel != "c:version" || body != [1, 1] {
+            return Err(Failure("unsupported_test_task"));
+        }
+        Ok(vec![Reply {
+            channel: channel.into(),
+            body: vec![1, 1],
+        }])
+    }
+    fn finish(&mut self) -> Result<()> {
+        self.0.finishes.fetch_add(1, Ordering::Relaxed);
+        Err(Failure("pending_required_tasks"))
+    }
+    fn reset(&mut self) {
+        self.0.resets.fetch_add(1, Ordering::Relaxed);
+    }
+}
+impl Factory for Arc<Observed> {
+    fn create(&self, hash: [u8; 32]) -> Result<Box<dyn Bridge>> {
+        assert_eq!(hash, [7; 32]);
+        self.created.fetch_add(1, Ordering::Relaxed);
+        Ok(Box::new(VersionBridge(self.clone())))
+    }
+}
+fn profile(observed: &Arc<Observed>) -> Profile {
+    Profile::neoforge(
+        "1.21.1",
+        767,
+        "21.1.248",
+        [7; 32],
+        vec!["demo:task".into()],
+        Arc::new(observed.clone()),
+    )
+    .unwrap()
+}
+
+#[test]
+fn early_loader_delivery_preserves_body_and_replies_without_an_accepted_horizon_epoch() {
+    let observed = Arc::new(Observed::default());
+    let profile = profile(&observed);
+    let mut endpoint = profile.begin().unwrap();
+    let replies = endpoint.receive("c:version", &[1, 1]).unwrap();
+    assert_eq!(replies.len(), 1);
+    assert_eq!(replies[0].channel, "c:version");
+    assert_eq!(replies[0].body, [1, 1]);
+    assert_eq!(
+        *observed.received.lock().unwrap(),
+        [("c:version".into(), vec![1, 1])]
+    );
+}
+
+#[test]
+fn unsupported_neoforge_tasks_poison_the_epoch_and_cannot_finish() {
+    let observed = Arc::new(Observed::default());
+    let profile = profile(&observed);
+    let mut endpoint = profile.begin().unwrap();
+    assert_eq!(
+        endpoint.receive("neoforge:register", &[0]).err(),
+        Some(Failure("unsupported_test_task"))
+    );
+    assert_eq!(
+        endpoint.receive("c:version", &[1, 1]).err(),
+        Some(Failure("failed_epoch"))
+    );
+    assert_eq!(endpoint.finish(), Err(Failure("failed_epoch")));
+    assert_eq!(observed.finishes.load(Ordering::Relaxed), 0);
+}
+
+#[test]
+fn undeclared_or_oversized_payloads_never_reach_bridge() {
+    for (channel, body) in [
+        ("other:task", vec![0]),
+        ("horizon:payloads", vec![0]),
+        ("c:version", vec![0; MAX_BODY + 1]),
+        ("neoforge:BAD", vec![0]),
+    ] {
+        let observed = Arc::new(Observed::default());
+        let profile = profile(&observed);
+        assert!(profile.begin().unwrap().receive(channel, &body).is_err());
+        assert!(observed.received.lock().unwrap().is_empty());
+    }
+}
+
+#[test]
+fn finish_refuses_pending_tasks_and_drop_resets_before_next_epoch() {
+    let observed = Arc::new(Observed::default());
+    let profile = profile(&observed);
+    {
+        let mut endpoint = profile.begin().unwrap();
+        assert_eq!(endpoint.finish(), Err(Failure("pending_required_tasks")));
+    }
+    assert_eq!(observed.resets.load(Ordering::Relaxed), 1);
+    {
+        let mut next = profile.begin().unwrap();
+        assert!(next.receive("c:version", &[1, 1]).is_ok());
+    }
+    assert_eq!(observed.created.load(Ordering::Relaxed), 2);
+    assert_eq!(observed.resets.load(Ordering::Relaxed), 2);
+}
+
+struct InvalidBridge {
+    reply_channel: &'static str,
+    complete: bool,
+}
+impl Bridge for InvalidBridge {
+    fn receive(&mut self, _: &str, _: &[u8]) -> Result<Vec<Reply>> {
+        // Only adversarial tests instantiate this deliberately invalid bridge.
+        Ok(vec![
+            Reply {
+                channel: "c:version".into(),
+                body: vec![1, 1],
+            },
+            Reply {
+                channel: self.reply_channel.into(),
+                body: vec![0],
+            },
+        ])
+    }
+    fn finish(&mut self) -> Result<()> {
+        if self.complete {
+            Ok(())
+        } else {
+            Err(Failure("incomplete"))
+        }
+    }
+    fn reset(&mut self) {
+        self.complete = false;
+    }
+}
+#[test]
+fn invalid_batch_is_rejected_whole_and_even_optimistic_bridge_cannot_enter_play() {
+    let observed = Arc::new(Observed::default());
+    let profile = profile(&observed);
+    let mut endpoint = Endpoint {
+        profile: &profile,
+        bridge: Box::new(InvalidBridge {
+            reply_channel: "horizon:payloads",
+            complete: true,
+        }),
+        failed: false,
+    };
+    assert_eq!(
+        endpoint.receive("c:version", &[1, 1]).err(),
+        Some(Failure("invalid_reply_batch"))
+    );
+    assert!(endpoint.finish().is_err());
+    let mut endpoint = Endpoint {
+        profile: &profile,
+        bridge: Box::new(InvalidBridge {
+            reply_channel: "c:version",
+            complete: true,
+        }),
+        failed: false,
+    };
+    assert_eq!(
+        endpoint.finish(),
+        Err(Failure("modded_play_boundary_not_implemented"))
+    );
+}
+
+#[test]
+fn profile_rejects_wrong_baselines_and_reserved_or_duplicate_adapters() {
+    let observed = Arc::new(Observed::default());
+    let factory: Arc<dyn Factory> = Arc::new(observed);
+    for (mc, protocol, nf) in [
+        ("1.21", 767, "21.1.248"),
+        ("1.21.1", 777, "21.1.248"),
+        ("1.21.1", 767, "21.1.249"),
+    ] {
+        assert!(Profile::neoforge(mc, protocol, nf, [7; 32], vec![], factory.clone()).is_err());
+    }
+    for channels in [
+        vec!["neoforge:task"],
+        vec!["horizon:task"],
+        vec!["demo:a", "demo:a"],
+        vec!["BAD:task"],
+        vec!["minecraft:brand"],
+    ] {
+        assert!(
+            Profile::neoforge(
+                "1.21.1",
+                767,
+                "21.1.248",
+                [7; 32],
+                channels.into_iter().map(str::to_owned).collect(),
+                factory.clone()
+            )
+            .is_err()
+        );
+    }
+}
+
+#[test]
+fn payload_refusal_diagnostics_do_not_reflect_invalid_or_unbounded_identifiers() {
+    let failure = Failure("unowned_configuration_payload");
+    assert_eq!(
+        failure.at_payload("neoforge:network"),
+        "configuration/neoforge:network: Failure(\"unowned_configuration_payload\")"
+    );
+    for channel in ["x:".to_owned() + &"a".repeat(32_765), "bad:\nsecret".into()] {
+        assert_eq!(
+            failure.at_payload(&channel),
+            "configuration/<invalid-channel>: Failure(\"unowned_configuration_payload\")"
+        );
+    }
+}
+
+#[test]
+fn unwinding_external_bridge_panic_poisoned_epoch_cannot_resume_or_finish() {
+    struct PanickingBridge(Arc<Observed>);
+    impl Bridge for PanickingBridge {
+        fn receive(&mut self, _: &str, _: &[u8]) -> Result<Vec<Reply>> {
+            panic!("test-only external bridge panic")
+        }
+        fn finish(&mut self) -> Result<()> {
+            self.0.finishes.fetch_add(1, Ordering::Relaxed);
+            Ok(())
+        }
+        fn reset(&mut self) {
+            self.0.resets.fetch_add(1, Ordering::Relaxed);
+        }
+    }
+    let observed = Arc::new(Observed::default());
+    let profile = profile(&observed);
+    let mut endpoint = Endpoint {
+        profile: &profile,
+        bridge: Box::new(PanickingBridge(observed.clone())),
+        failed: false,
+    };
+    assert!(
+        std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let _ = endpoint.receive("c:version", &[1, 1]);
+        }))
+        .is_err()
+    );
+    assert_eq!(
+        endpoint.receive("c:version", &[1, 1]).err(),
+        Some(Failure("failed_epoch"))
+    );
+    assert_eq!(endpoint.finish(), Err(Failure("failed_epoch")));
+    assert_eq!(observed.finishes.load(Ordering::Relaxed), 0);
+    drop(endpoint);
+    assert_eq!(observed.resets.load(Ordering::Relaxed), 1);
+}
