+    fn outbound_preparation_preserves_socket_counters_compression_and_cipher() {
+        for threshold in [None, Some(0), Some(256)] {
+            let (mut client, peer) = outbound_configured();
+            let (mut control, _control_peer) = outbound_configured();
+            for c in [&mut client, &mut control] {
+                c.enable_encryption(&[7; 16]);
+                c.writer.threshold = threshold;
+            }
+            let before = outbound_counters(&client);
+            for _ in 0..2 {
+                assert_eq!(
+                    client
+                        .writer
+                        .prepare_serverbound_configuration(&[7, 0])
+                        .unwrap(),
+                    [7, 0]
+                );
+                assert!(
+                    client
+                        .writer
+                        .prepare_serverbound_configuration(&[3])
+                        .is_err()
+                );
+            }
+            assert_eq!(outbound_counters(&client), before);
+            assert_eq!(client.writer.threshold, threshold);
+            let Stream::Tcp(stream) = &peer.reader.stream else {
+                panic!("network peer");
+            };
+            stream.set_nonblocking(true).unwrap();
+            assert_eq!(
+                stream.peek(&mut [0]).unwrap_err().kind(),
+                std::io::ErrorKind::WouldBlock
+            );
+            stream.set_nonblocking(false).unwrap();
+            // Subsequent real compression + cipher output must match an untouched
+            // writer, including the next packet's running cipher state.
+            for body in [&[7, 0][..], &[4, 0, 0, 0, 0, 0, 0, 0, 9][..]] {
+                let mut got = Vec::new();
+                let mut expected = Vec::new();
+                let contents = client.writer.contents(body).unwrap();
+                client.writer.frame_into(&contents, &mut got);
+                let contents = control.writer.contents(body).unwrap();
+                control.writer.frame_into(&contents, &mut expected);
+                assert_eq!(got, expected);
+            }
+        }
