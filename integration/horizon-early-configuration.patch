+#[test]
+fn explicit_neoforge_routes_before_horizon_and_refuses_finish_without_ack_or_epoch() {
+    use horizon_world::native_load_context::DataLoadOrigin;
+    let root = std::env::temp_dir().join(format!("horizon-early-{}", next_serial()));
+    std::fs::create_dir_all(&root).unwrap();
+    std::fs::write(root.join("items.json"), "{}").unwrap();
+    let resources = crate::test_resources::item_data(&root, DataLoadOrigin::ClientPreload).unwrap();
+    let observed = Arc::new(Observed::default());
+    let profile = Profile::neoforge(
+        "1.21.1",
+        767,
+        "21.1.248",
+        [7; 32],
+        vec![],
+        Arc::new(observed.clone()),
+    )
+    .unwrap();
+    let payloads =
+        crate::raw_payloads::Transport::capture(crate::raw_payloads::Side::Client).unwrap();
+    for initial in [true, false] {
+        let (client, server) = horizon_protocol::connection::Pipe::pair();
+        let mut client = Connection::local(client);
+        client.adapt(horizon_protocol::adapter::ServerVersion::V1_21_1);
+        let mut server = Connection::local(server);
+        server
+            .reader
+            .set_read_timeout(Some(Duration::from_millis(50)))
+            .unwrap();
+        client
+            .send(
+                &handshake::Serverbound::Intention(handshake::Intention {
+                    protocol: PROTOCOL_VERSION,
+                    host: "localhost".into(),
+                    port: 25565,
+                    intent: handshake::LOGIN,
+                })
+                .encode(),
+            )
+            .unwrap();
+        server.recv().unwrap();
+        server.send(&[2]).unwrap();
+        client.recv().unwrap();
+        client
+            .send(&login::Serverbound::LoginAcknowledged(Empty).encode())
+            .unwrap();
+        server.recv().unwrap();
+        let (mut reader, writer) = client.split();
+        let writer = Arc::new(Mutex::new(Some(QueuedWriter::new(writer).unwrap())));
+        let configuring = Arc::new(AtomicBool::new(true));
+        let (send, _events) = event_channel();
+        let mut brand = horizon_protocol::buf::Writer::new();
+        brand.string("horizon"); // MUST NOT activate any Horizon offers.
+        for (channel, data) in [("minecraft:brand", brand.data), ("c:version", vec![1, 1])] {
+            server
+                .send(
+                    &cfg::Clientbound::CustomPayload(cfg::CustomPayload {
+                        channel: channel.into(),
+                        data,
+                    })
+                    .encode(),
+                )
+                .unwrap();
+        }
+        server
+            .send(&cfg::Clientbound::KeepAlive(cfg::KeepAlive { id: 42 }).encode())
+            .unwrap();
+        server
+            .send(&cfg::Clientbound::Ping(cfg::Ping { id: 13 }).encode())
+            .unwrap();
+        server
+            .send(&cfg::Clientbound::FinishConfiguration(Empty).encode())
+            .unwrap();
+        // Queue a later packet; the refusing engine must never read it.
+        server.send(&[0]).unwrap();
+        let result = configure_with_profile(
+            &mut reader,
+            &writer,
+            &configuring,
+            &Language::new(),
+            &send,
+            &Cookies::default(),
+            &resources,
+            &payloads,
+            initial,
+            Some(&profile),
+        );
+        assert!(
+            result
+                .err()
+                .unwrap()
+                .text
+                .contains("required_tasks_pending")
+        );
+        assert!(configuring.load(Ordering::Acquire));
+        assert!(
+            payloads.epoch().is_none(),
+            "no fabricated Horizon acceptance"
+        );
+        let drained = writer
+            .lock()
+            .unwrap()
+            .as_ref()
+            .unwrap()
+            .drain_and_take()
+            .unwrap();
+        let (id, bytes) = server.recv().unwrap();
+        assert_eq!(id, 2);
+        let cfg::Serverbound::CustomPayload(reply) = cfg::Serverbound::decode(id, &bytes).unwrap()
+        else {
+            panic!("only loader response expected");
+        };
+        assert_eq!(
+            (reply.channel.as_str(), reply.data.as_slice()),
+            ("c:version", &[1, 1][..])
+        );
+        let (id, bytes) = server.recv().unwrap();
+        assert_eq!(
+            cfg::Serverbound::decode(id, &bytes).unwrap(),
+            cfg::Serverbound::KeepAlive(cfg::KeepAlive { id: 42 })
+        );
+        let (id, bytes) = server.recv().unwrap();
+        assert_eq!(
+            cfg::Serverbound::decode(id, &bytes).unwrap(),
+            cfg::Serverbound::Pong(cfg::Ping { id: 13 })
+        );
+        assert!(server.recv().is_err(), "no Horizon offer or finish ack");
+        // The adapter read phase switched on FinishConfiguration already. The
+        // engine returned without consuming a following play/unknown packet.
+        assert_eq!(reader.recv().unwrap(), (0, vec![]));
+        drained.shutdown();
+    }
+    assert_eq!(observed.starts.load(Ordering::Relaxed), 2);
+    assert_eq!(observed.resets.load(Ordering::Relaxed), 2);
+    assert_eq!(observed.received.lock().unwrap().len(), 2);
+    std::fs::remove_dir_all(root).unwrap();
+}
