+    #[test]
+    fn reassembled_failure_refuses_external_and_raw_reads_before_side_effects() {
+        let (client, _peer) = configured();
+        let (_socket, mut reader, _writer) = client.detach();
+        assert!(reader.decode_reassembled_configuration(vec![]).is_err());
+        let mut source = std::io::Cursor::new(vec![0; 32]);
+        let bytes_in = reader.counters.bytes_in.load(Ordering::Relaxed);
+        assert_eq!(
+            reader.read_from(&mut source).unwrap_err().kind(),
+            std::io::ErrorKind::NotConnected
+        );
+        assert_eq!(source.position(), 0, "poison must precede external I/O");
+        assert_eq!(reader.counters.bytes_in.load(Ordering::Relaxed), bytes_in);
+        assert!(reader.buffer.is_empty());
+        assert_eq!((reader.start, reader.end), (0, 0));
+        assert!(
+            reader.read_raw(0).is_err(),
+            "zero bytes cannot bypass poison"
+        );
+        // Vec allocation would panic for this size if attempted before refusal.
+        assert!(reader.read_raw(usize::MAX).is_err());
+        assert!(reader.buffered().is_err());
+        assert!(reader.recv().is_err());
+    }
