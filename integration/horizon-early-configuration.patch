+                    let session = client.writer.adapter.as_ref().unwrap();
+                    assert_eq!(session.reading(), State::Configuration);
+                    assert_eq!(session.writing(), State::Configuration);
+                }
+                2 => client.adapt(ServerVersion::V1_21_1), // fresh: handshake
+                3 => {
+                    // Only reading has left configuration. This queues actual
+                    // adapter packets; preparation must not deliver/drain them.
+                    client
+                        .reader
+                        .adapter
+                        .as_ref()
+                        .unwrap()
