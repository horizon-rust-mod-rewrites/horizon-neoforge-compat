+// SPDX-License-Identifier: LGPL-3.0-or-later
+//! Engine tests for the ordered connection owner. These drive the actual
+//! `configure_with_profile` entry point and the real `Connection`/`QueuedWriter`
+//! with synthetic transports; they are NOT a live NeoForge join. The owner's hard
+//! finish latch and default-off split authority are asserted throughout.
+//!
+//! The configure-entry test needs no companion. The owner-direct split tests use
+//! the real compatibility reassembler and are compiled only when the companion is
+//! wired (`compat_isolated` is NOT set), matching the existing companion tests.
+use super::*;
+use early_configuration::{Bridge, Factory, Failure, Profile, Reply};
+use std::sync::atomic::AtomicUsize;
+
+#[derive(Default)]
+struct Observed {
+    starts: AtomicUsize,
+    resets: AtomicUsize,
+    received: Mutex<Vec<(String, Vec<u8>)>>,
+}
+struct VersionOnly(Arc<Observed>);
+impl Bridge for VersionOnly {
+    fn receive(&mut self, channel: &str, body: &[u8]) -> early_configuration::Result<Vec<Reply>> {
+        self.0
+            .received
+            .lock()
+            .unwrap()
+            .push((channel.into(), body.to_vec()));
+        if channel != "c:version" || body != [1, 1] {
+            return Err(Failure("unsupported_test_task"));
+        }
+        Ok(vec![Reply {
+            channel: channel.into(),
+            body: vec![1, 1],
+        }])
+    }
+    fn finish(&mut self) -> early_configuration::Result<()> {
+        Err(Failure("required_tasks_pending"))
+    }
+    fn reset(&mut self) {
+        self.0.resets.fetch_add(1, Ordering::Relaxed);
+    }
+}
+impl Factory for Arc<Observed> {
+    fn create(&self, _: [u8; 32]) -> early_configuration::Result<Box<dyn Bridge>> {
+        self.starts.fetch_add(1, Ordering::Relaxed);
+        Ok(Box::new(VersionOnly(self.clone())))
+    }
+}
+
+fn profile(observed: &Arc<Observed>) -> Profile {
+    Profile::neoforge(
+        "1.21.1",
+        767,
+        "21.1.248",
+        [7; 32],
+        vec![],
+        Arc::new(observed.clone()),
+    )
+    .unwrap()
+}
