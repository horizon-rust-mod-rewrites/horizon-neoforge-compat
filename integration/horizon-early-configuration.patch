+    fn outbound_preparation_leaves_real_adapter_queued_packets_untouched() {
+        use crate::buf::{Codec, LpVec3, Writer};
+        use crate::ids::play;
+
+        // Queue packets via actual adapter translation, not private test setters
+        // or replacement Session APIs; return both phases to configuration.
+        fn seed(session: &crate::adapter::Session) {
+            session.clientbound(3, vec![]).unwrap();
+            session
+                .serverbound(&cfg::Serverbound::FinishConfiguration(Empty).encode())
+                .unwrap();
+            let mut interact = Writer::new();
+            interact.varint(play::serverbound::INTERACT);
+            interact.varint(7);
+            interact.varint(0);
+            LpVec3::write(&[0.0; 3], &mut interact);
+            interact.bool(false);
+            assert!(session.serverbound(&interact.data).unwrap().is_some());
+            let start = (0..256)
+                .find(|&id| {
+                    session.version.clientbound_id(State::Play, id)
+                        == Some(play::clientbound::START_CONFIGURATION)
+                })
+                .unwrap();
+            session.clientbound(start, vec![]).unwrap();
+            let mut ack = Writer::new();
+            ack.varint(play::serverbound::CONFIGURATION_ACKNOWLEDGED);
+            session.serverbound(&ack.data).unwrap();
+            assert_eq!(session.reading(), State::Configuration);
+            assert_eq!(session.writing(), State::Configuration);
+        }
+        let (client, _peer) = outbound_configured();
+        let (control, _control_peer) = outbound_configured();
+        let session = client.writer.adapter.as_ref().unwrap();
+        let baseline = control.writer.adapter.as_ref().unwrap();
+        seed(session);
+        seed(baseline);
+        let counters = outbound_counters(&client);
+        assert!(
+            client
+                .writer
+                .prepare_serverbound_configuration(&[7, 0])
+                .is_ok()
+        );
+        assert!(
+            client
+                .writer
+                .prepare_serverbound_configuration(&[3])
+                .is_err()
+        );
+        assert_eq!(outbound_counters(&client), counters);
+        assert_eq!(session.reading(), State::Configuration);
+        assert_eq!(session.writing(), State::Configuration);
+        let expected = baseline.take_outgoing();
+        assert!(
+            !expected.is_empty(),
+            "real interact translation must queue a followup"
+        );
+        assert_eq!(session.take_outgoing(), expected);
+        let drain = |s: &crate::adapter::Session| {
+            std::iter::from_fn(|| s.next_incoming()).collect::<Vec<_>>()
+        };
+        let expected = drain(baseline);
+        assert!(
+            !expected.is_empty(),
+            "real finish translation must queue incoming packets"
+        );
+        assert_eq!(drain(session), expected);
+    }
