+        let mut client = Connection::local(a);
+        let mut peer = Connection::local(b);
+        client.adapt(ServerVersion::V1_21_1);
+        client
+            .send(
+                &handshake::Serverbound::Intention(handshake::Intention {
+                    protocol: crate::PROTOCOL_VERSION,
+                    host: "localhost".into(),
+                    port: 25565,
+                    intent: handshake::LOGIN,
+                })
+                .encode(),
+            )
+            .unwrap();
+        peer.recv().unwrap();
+        peer.send(&[2]).unwrap();
+        client.recv().unwrap();
+        client
+            .send(&login::Serverbound::LoginAcknowledged(Empty).encode())
+            .unwrap();
+        peer.recv().unwrap();
+        (client, peer)
+    }
