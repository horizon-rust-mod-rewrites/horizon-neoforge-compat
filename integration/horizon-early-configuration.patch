--- /dev/null
+++ b/crates/horizon-client/src/net/early_configuration.rs
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: LGPL-3.0-or-later
+//! Engine-owned, explicitly selected configuration endpoint. No global registration,
+//! Horizon negotiation, play delivery, or implicit permission from channel lists.
+use std::{collections::BTreeSet, sync::Arc};
+
+pub const MAX_BODY: usize = 32_767;
+const MAX_CHANNELS: usize = 1_024;
+const MAX_REPLIES: usize = 32;
+const MAX_REPLY_BYTES: usize = 65_536;
+
+/// Stable diagnostic code; the engine adds phase/channel context when displaying it.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Failure(pub &'static str);
+impl Failure {
+    /// The protocol identifier decoder accepts much longer identifiers than this
+    /// endpoint. Never reflect an invalid/overlong peer channel in diagnostics.
+    pub(crate) fn at_payload(&self, channel: &str) -> String {
+        let channel = if valid_id(channel) {
+            channel
+        } else {
+            "<invalid-channel>"
+        };
+        format!("configuration/{channel}: {self:?}")
+    }
+}
+pub type Result<T> = std::result::Result<T, Failure>;
+
+pub struct Reply {
+    pub channel: String,
+    /// Body only: never include the channel, packet id or length a second time.
+    pub body: Vec<u8>,
+}
+
+/// Implemented outside the engine by the actual compatibility layer. No default
+/// handlers: unsupported required work MUST return Err, never an empty success.
+/// Calls are synchronous on the network thread: bounded decoding/work only. A task
+/// needing main-thread completion must remain pending and refuse the finish barrier.
+pub trait Bridge: Send {
+    fn receive(&mut self, channel: &str, body: &[u8]) -> Result<Vec<Reply>>;
+    /// Must check negotiation, required handlers, tasks, and atomically applied maps.
+    fn finish(&mut self) -> Result<()>;
+    /// Discard all epoch state, including staged maps/work. Called on EVERY exit.
+    fn reset(&mut self);
+}
+
+/// A new, independent bridge for each configuration. Do not share mutable epochs
+/// between connections. The fingerprint identifies caller-attested pack inventory,
+/// not a claim that a server brand/status packet authenticates that inventory.
+pub trait Factory: Send + Sync {
+    fn create(&self, pack_sha256: [u8; 32]) -> Result<Box<dyn Bridge>>;
+}
+
+/// Connection-scoped opt-in; not a normal mod payload declaration. The caller
+/// supplies an exact out-of-band inventory and handler-backed adapter allowlist.
+#[derive(Clone)]
+pub struct Profile {
+    pack_sha256: [u8; 32],
+    adapters: BTreeSet<String>,
+    factory: Arc<dyn Factory>,
+}
+impl Profile {
+    pub fn neoforge(
+        minecraft: &str,
+        protocol: i32,
+        loader: &str,
+        pack_sha256: [u8; 32],
+        adapters: Vec<String>,
+        factory: Arc<dyn Factory>,
+    ) -> Result<Self> {
+        if (minecraft, protocol, loader) != ("1.21.1", 767, "21.1.248") {
+            return Err(Failure("unsupported_baseline"));
+        }
+        if pack_sha256 == [0; 32] || adapters.len() > MAX_CHANNELS {
+            return Err(Failure("invalid_inventory"));
+        }
+        let mut channels = BTreeSet::new();
+        for channel in adapters {
+            if !valid_id(&channel)
+                || matches!(
+                    namespace(&channel),
+                    "minecraft" | "neoforge" | "c" | "horizon"
+                )
+                || !channels.insert(channel)
+            {
+                return Err(Failure("invalid_adapter_declaration"));
+            }
+        }
+        Ok(Self {
+            pack_sha256,
+            adapters: channels,
+            factory,
+        })
+    }
+    pub(crate) fn begin(&self) -> Result<Endpoint<'_>> {
+        Ok(Endpoint {
+            profile: self,
+            bridge: self.factory.create(self.pack_sha256)?,
+            failed: false,
+        })
+    }
+    fn owns(&self, channel: &str) -> bool {
+        channel.starts_with("neoforge:")
+            || matches!(
+                channel,
+                "c:version" | "c:register" | "minecraft:register" | "minecraft:unregister"
+            )
+            || self.adapters.contains(channel)
+    }
+}
+fn namespace(channel: &str) -> &str {
+    channel.split_once(':').map_or("", |(ns, _)| ns)
+}
+fn valid_id(channel: &str) -> bool {
+    let Some((ns, path)) = channel.split_once(':') else {
+        return false;
+    };
+    !ns.is_empty()
+        && !path.is_empty()
+        && channel.len() <= 256
+        && ns
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"_.-".contains(&b))
+        && path
+            .bytes()
+            .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b"_.-/".contains(&b))
+}
+
+/// Lives on the configuration stack. Drop resets on failure, transfer, EOF and
+/// disconnect; the next configuration creates a new bridge, never reuses this one.
+pub(crate) struct Endpoint<'a> {
+    profile: &'a Profile,
+    bridge: Box<dyn Bridge>,
+    failed: bool,
+}
+impl Endpoint<'_> {
+    pub(crate) fn receive(&mut self, channel: &str, body: &[u8]) -> Result<Vec<Reply>> {
+        if self.failed {
+            return Err(Failure("failed_epoch"));
+        }
+        // Poison BEFORE crossing the external bridge boundary. If a caller
+        // catches an unwinding callback panic, it must not reuse this epoch.
+        self.failed = true;
+        let result = self.receive_inner(channel, body);
+        if result.is_ok() {
+            self.failed = false;
+        }
+        result
+    }
+    fn receive_inner(&mut self, channel: &str, body: &[u8]) -> Result<Vec<Reply>> {
+        if !valid_id(channel) || !self.profile.owns(channel) {
+            return Err(Failure("unowned_configuration_payload"));
+        }
+        if body.len() > MAX_BODY {
+            return Err(Failure("configuration_body_limit"));
+        }
+        let replies = self.bridge.receive(channel, body)?;
+        // Validate the WHOLE batch before any packet is queued. A registration
+        // list never expands ownership; the bridge enforces negotiated flow too.
+        if replies.len() > MAX_REPLIES {
+            return Err(Failure("reply_count_limit"));
+        }
+        let mut bytes = 0usize;
+        for reply in &replies {
+            bytes = bytes.saturating_add(reply.body.len() + reply.channel.len());
+            if !valid_id(&reply.channel)
+                || !self.profile.owns(&reply.channel)
+                || reply.body.len() > MAX_BODY
+                || bytes > MAX_REPLY_BYTES
+            {
+                return Err(Failure("invalid_reply_batch"));
+            }
+        }
+        Ok(replies)
+    }
+    pub(crate) fn finish(&mut self) -> Result<()> {
+        if self.failed {
+            return Err(Failure("failed_epoch"));
+        }
+        self.failed = true;
+        self.bridge.finish()?;
+        // Deliberate safety latch: this patch has no bidirectional modded content
+        // conversion or play route. Even a buggy/overoptimistic bridge cannot ack
+        // finish and expose modded IDs to vanilla translation. Remove only in a
+        // separately validated engine/content integration, not a codec milestone.
+        Err(Failure("modded_play_boundary_not_implemented"))
+    }
+}
+impl Drop for Endpoint<'_> {
+    fn drop(&mut self) {
+        self.bridge.reset();
+    }
+}
+
